                  "component": "VCol",
                  "props": {
                    "cols": 12,
                    "md": 4
                  },
                  "content": [
                    {
                      "component": "VTextField",
                      "props": {
                        "model": "labelsafterseed",
                        "label": "辅种后增加标签",
                        "placeholder": "使用,分隔多个标签,不填写则默认为(已整理,辅种)"
                      }
                    }
                  ]
                },
                {
                  "component": "VCol",
                  "props": {
                    "cols": 12,
                    "md": 4
                  },
                  "content": [
                    {
                      "component": "VTextField",
                      "props": {
                        "model": "categoryafterseed",
                        "label": "辅种后增加分类",
