                              "lg": 12,
                              "md": 12,
                              "sm": 12,
                              "xs": 12
                            },
                            "content": [
                              {
                                "component": "VSelect",
                                "props": {
                                  "model": "custom.iyuu.enable_notify_types",
                                  "label": "消息类型",
                                  "multiple": true,
                                  "chips": true,
                                  "clearable": true,
                                  "items": [
                                    {
                                      "title": "资源下载",
                                      "value": "Download"
                                    },
                                    {
                                      "title": "整理入库",
                                      "value": "Organize"
                                    },
                                    {
                                      "title": "订阅",
                                      "value": "Subscribe"
                                    },
                                    {
                                      "title": "站点",
                                      "value": "SiteMessage"
                                    },
                                    {
                                      "title": "媒体服务器",
                                      "value": "MediaServer"
                                    },
                                    {
                                      "title": "手动处理",
                                      "value": "Manual"
                                    },
                                    {
                                      "title": "插件",
                                      "value": "Plugin"
                                    },
                                    {
                                      "title": "其它",
                                      "value": "Other"
                                    }
                                  ],
                                  "hint": "选择哪些类型的消息需要通过此渠道发送，缺省时不限制类型。"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "component": "VRow",
                        "content": [
