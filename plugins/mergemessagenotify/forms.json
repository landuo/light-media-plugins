                                "component": "VSwitch",
                                "props": {
                                  "model": "custom.iyuu.test_once",
                                  "label": "测试一下",
                                  "hint": "保存后立即发送一条测试信息，仅生效一次。"
                                }
                              }
                            ]
                          }
