                              "cols": 12,
                              "xxl": 12,
                              "xl": 12,
                              "lg": 12,
                              "md": 12,
                              "sm": 12,
                              "xs": 12
                            },
                            "content": [
                              {
                                "component": "VTextField",
                                "props": {
                                  "model": "custom.iyuu.token",
                                  "label": "IYUU令牌",
                                  "placeholder": "IYUUxxx",
                                  "hint": "必填。请前往爱语飞飞官网获取令牌：https://iyuu.cn",
                                  "type": "password"
                                }
                              }
                            ]
                          }
                        ]
