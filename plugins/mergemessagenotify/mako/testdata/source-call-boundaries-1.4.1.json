      "name": "untaken-control-default-effects",
      "template": "<%def name=\"wrap()\">[${caller.hidden()}]</%def><%call expr=\"wrap()\">\n% if False:\n<%def name=\"hidden(v=context.write('D'))\">H</%def>\n% endif\n</%call>",
      "vars": {
