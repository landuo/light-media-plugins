  "cases": [
    {
      "name": "ordinary-caller-is-false",
      "template": "<%def name=\"f()\">${bool(caller)}</%def>${bool(caller)}|${f()}|${bool(caller)}",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "False|False|False",
      "source_error": false
    },
    {
      "name": "body-and-capture",
      "template": "<%def name=\"wrap()\">[${capture(caller.body)}][${caller.body()}]</%def><%call expr=\"wrap()\">${title}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "[Owned <text>][Owned <text>]",
      "source_error": false
    },
    {
      "name": "passed-body-args",
      "template": "<%def name=\"wrap(a)\">${caller.body(a, extra=4)}</%def><%call expr=\"wrap(count)\" args=\"value, extra=2\">${value}:${extra}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "7:4",
      "source_error": false
    },
    {
      "name": "body-defaults-at-tag",
      "template": "<% base = 11 %><%def name=\"wrap()\">${caller.body()}</%def><%call expr=\"wrap()\" args=\"value=base\">${value}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "11",
      "source_error": false
    },
    {
      "name": "body-star-keyword-only",
      "template": "<%def name=\"wrap()\">${caller.body(1, 2, 3, label=4)}</%def><%call expr=\"wrap()\" args=\"first, *rest, label\">${first}|${rest}|${label}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "1|(2, 3)|4",
      "source_error": false
    },
    {
      "name": "body-keyword-catchall",
      "template": "<%def name=\"wrap()\">${caller.body(1, z=2, a=3)}</%def><%call expr=\"wrap()\" args=\"first, **rest\">${first}|${rest}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "1|{'z': 2, 'a': 3}",
      "source_error": false
    },
    {
      "name": "body-bare-keyword-marker",
      "template": "<%def name=\"wrap()\">${caller.body(1, 2)}</%def><%call expr=\"wrap()\" args=\"first, *, second\">${first}|${second}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "1|2",
      "source_error": false
    },
    {
      "name": "self-closing",
      "template": "<%def name=\"wrap()\">${bool(caller)}:[${caller.body()}]</%def><%call expr=\"wrap()\"/>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "True:[]",
      "source_error": false
    },
    {
      "name": "expression-result-with-page-filter",
      "template": "<%page expression_filter=\"h\"/><%call expr=\"title\"/>|<%call expr=\"count\"/>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "Owned &lt;text&gt;|7",
      "source_error": false
    },
    {
      "name": "buffered-def-return",
      "template": "<%def name=\"wrap()\" buffered=\"True\">[\n${caller.body()}\n]</%def><%call expr=\"wrap()\">${title}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "[\nOwned <text>\n]",
      "source_error": false
    },
    {
      "name": "caller-exports-named-def-and-block",
      "template": "<%def name=\"wrap()\">[${caller.part(count)}|${caller.section()}|${caller.body()}]</%def><%call expr=\"wrap()\"><%def name=\"part(v)\">P${v}</%def><%block name=\"section\">S</%block>B</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "<%def name=\"wrap()\">[${caller.part(count)}|${caller.section()}|${caller.body()}]</%def><%call expr=\"wrap()\"><%def name=\"part(v)\">P${v}</%def><%block name=\"section\">S</%block>B</%call>",
      "source_error": true
    },
    {
      "name": "export-default-keeps-call-site-scope",
      "template": "<% v = 8 %><%def name=\"wrap()\">${caller.part()}</%def><%call expr=\"wrap()\"><%def name=\"part(x=v)\">${x}</%def></%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "8",
      "source_error": false
    },
    {
      "name": "nested-body-keeps-outer-caller",
      "template": "<%def name=\"outer()\">O[${caller.piece()}|${caller.body()}]</%def><%def name=\"inner()\">I[${caller.body()}]</%def><%call expr=\"outer()\"><%def name=\"piece()\">P</%def><%call expr=\"inner()\">${bool(caller)}|${bool(context.get(\"caller\"))}</%call></%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "O[P|I[False|True]]",
      "source_error": false
    },
    {
      "name": "nested-def-reads-own-frame",
      "template": "<%def name=\"outer()\">O[${caller.body()}]</%def><%def name=\"inner()\">I[${caller.body()}]</%def><%def name=\"middle()\">M[${bool(caller)}|<%call expr=\"inner()\">${caller.mark()}</%call>]</%def><%call expr=\"outer()\"><%def name=\"mark()\">Q</%def><%call expr=\"middle()\"><%def name=\"mark()\">P</%def></%call></%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "O[M[True|I[P]]]",
      "source_error": false
    },
    {
      "name": "arguments-also-see-pending-frame",
      "template": "<%def name=\"argument()\" buffered=\"True\">${bool(caller)}</%def><%def name=\"wrap(v)\">${v}:${caller.body()}</%def><%call expr=\"wrap(argument())\">B</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "True:B",
      "source_error": false
    },
    {
      "name": "frame-restored-after-handled-error",
      "template": "<%def name=\"bad()\">${1/0}</%def><%def name=\"wrap()\">[\n% try:\n<%call expr=\"bad()\">lost</%call>\n% except ZeroDivisionError:\n${caller.body()}\n% endtry\n]</%def><%call expr=\"wrap()\">kept</%call>|${bool(caller)}",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "[\nkept\n]|False",
      "source_error": false
    },
    {
      "name": "body-can-be-used-as-plain-callable",
      "template": "<%def name=\"wrap()\">${capture(caller.body, count)}</%def><%call expr=\"wrap()\" args=\"n\">${n}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "7",
      "source_error": false
    },
    {
      "name": "body-argument-error-fallback",
      "template": "<%def name=\"wrap()\">${caller.body()}</%def><%call expr=\"wrap()\" args=\"required\">${required}</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "<%def name=\"wrap()\">${caller.body()}</%def><%call expr=\"wrap()\" args=\"required\">${required}</%call>",
      "source_error": true
    },
    {
      "name": "missing-expr-fallback",
      "template": "<%call>body</%call>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "<%call>body</%call>",
      "source_error": true
    },
    {
      "name": "namespace-shorthand",
      "template": "<%def name=\"wrap(a, b)\">${a}:${b}:[${caller.body(a)}]</%def><%self:wrap a=\"${count}\" b=\"prefix-${title}\" args=\"v\">${v}</%self:wrap>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "7:prefix-Owned <text>:[7]",
      "source_error": false
    },
    {
      "name": "namespace-self-closing",
      "template": "<%def name=\"wrap(a)\">${a}:[${caller.body()}]</%def><%local:wrap a=\"owned\"/>",
      "vars": {
        "title": "Owned <text>",
        "count": 7
      },
      "expected": "owned:[]",
      "source_error": false
    }
  ]
}
