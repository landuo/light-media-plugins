  "cases": [
    {
      "name": "lexical-context-and-direct-namespace",
      "template": "<% x='page' %><%def name=\"f()\" buffered=\"True\">${x}</%def>${f()}|${self.f()}",
      "vars": {
        "title": "Owned",
        "count": 7,
        "x": "root"
      },
      "expected": "page|root",
      "source_error": false
    },
    {
      "name": "root-definition-forwards-current-context",
      "template": "<% x='page' %><%def name=\"f()\" buffered=\"True\">${x}</%def><%def name=\"g()\" buffered=\"True\">${f()}</%def>${g()}|${self.g()}",
      "vars": {
        "title": "Owned",
        "count": 7,
        "x": "root"
      },
      "expected": "page|root",
      "source_error": false
    },
    {
      "name": "top-level-decorator-context-selection",
      "template": "<%! decorate=lambda fn: lambda ctx: ctx.get('x') + ':' + fn() %><% x='page' %><%def name=\"f()\" buffered=\"True\" decorator=\"decorate\">${x}</%def>${f()}|${self.f()}",
      "vars": {
        "title": "Owned",
        "count": 7,
        "x": "root"
      },
      "expected": "page:page|root:root",
      "source_error": false
    },
    {
      "name": "named-block-uses-direct-namespace",
      "template": "<% x='page' %><%block name=\"block\">${x}</%block>",
      "vars": {
        "title": "Owned",
        "count": 7,
        "x": "root"
      },
      "expected": "root",
      "source_error": false
    },
    {
      "name": "mixed-definition-and-named-block-collision",
      "template": "<%def name=\"thing()\">definition</%def><%block name=\"thing\">block</%block>${title}",
      "vars": {
        "title": "Owned",
        "count": 7,
        "x": "root"
      },
      "expected": "<%def name=\"thing()\">definition</%def><%block name=\"thing\">block</%block>${title}",
      "source_error": true
    }
  ]
