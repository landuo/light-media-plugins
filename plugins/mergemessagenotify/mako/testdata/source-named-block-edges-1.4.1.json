  "cases": [
    {
      "name": "explicit-pageargs-required-collision",
      "template": "before<%page args=\"pageargs\"/>after",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "before<%page args=\"pageargs\"/>after",
      "source_error": true
    },
    {
      "name": "explicit-pageargs-default-collision",
      "template": "before<%page args=\"title, pageargs=None\"/>after",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "before<%page args=\"title, pageargs=None\"/>after",
      "source_error": true
    },
    {
      "name": "named-block-over-module-value",
      "template": "<%! box='module' %><%page args=\"title\"/><%block name=\"box\" args=\"title\">${title}</%block>|${capture(box,'X')}",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "Owned|X",
      "source_error": false
    },
    {
      "name": "named-block-owner-over-module-value",
      "template": "<%! box='module' %><%block name=\"box\">${box.__name__}</%block>",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "box",
      "source_error": false
    },
    {
      "name": "unrelated-def-uses-module-value",
      "template": "<%! box='module' %><%block name=\"box\">block</%block><%def name=\"who()\" buffered=\"True\">${box}</%def>|${who()}",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "block|module",
      "source_error": false
