  "cases": [
    {
      "name": "named-args-forward-page",
      "template": "<%page args=\"title,count\"/><%block name=\"box\" args=\"title,count\">${title}:${count}</%block>",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "Owned:7",
      "source_error": false
    },
    {
      "name": "named-no-page-arguments-fallback",
      "template": "before<%block name=\"box\" args=\"title='default'\">${title}</%block>after",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "before<%block name=\"box\" args=\"title='default'\">${title}</%block>after",
      "source_error": true
    },
    {
      "name": "named-untaken-still-requires-page-arguments",
      "template": "before\n% if False:\n<%block name=\"box\" args=\"title='default'\">${title}</%block>\n% endif\nafter",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "before\n% if False:\n<%block name=\"box\" args=\"title='default'\">${title}</%block>\n% endif\nafter",
      "source_error": true
    },
    {
      "name": "named-page-assignment-after-entry-is-too-late",
      "template": "<% title='assigned' %><%block name=\"box\" args=\"title\">${title}</%block>",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "<% title='assigned' %><%block name=\"box\" args=\"title\">${title}</%block>",
      "source_error": true
    },
    {
      "name": "named-page-default-and-original-default",
      "template": "<%!\nevents = ''\ndef step(marker):\n    global events\n    events += marker\n    return events\ndef trace():\n    return events\n%><%page args=\"title=step('P')\"/><%block name=\"box\" args=\"title=step('B')\">${title}:${trace()}</%block>|${capture(self.box)}|${capture(box)}|${trace()}",
      "vars": {
        "title": "Owned",
        "count": 7
      },
      "expected": "Owned:PBBB|PB:PBBBB|PBB:PBBBBB|PBBBBB",
      "source_error": false
    },
    {
      "name": "named-page-keyword-rest",
      "template": "<%page args=\"title\"/><%block name=\"box\" args=\"title\">${title}:${pageargs.get('count','none')}</%block>|${capture(self.box,'direct',count=9)}|${capture(box,'lexical')}",
      "vars": {
