{
  "mako": "1.4.1",
  "markupsafe": "3.0.3",
  "python": "3.12.13 (main, Apr 14 2026, 14:33:40) [Clang 22.1.3 ]",
  "source_sha256": {
    "mergemessagenotify/util.py": "33cd9fa88f42e8e1918ff12d268c5a4260f79e598d2da6b7336428d68028b4a0",
    "mako/parsetree.py": "c8518e095b1bd74c62192889d942a7f08ed7b524b9a89fc0dd67651278feff57",
    "mako/codegen.py": "f271c29d3ec96cbaa76724beb38cea2e6dded99e428ce9a2163493c2024a7ae1",
    "mako/template.py": "869cb055b2aa13f173626bb2ee86768c8d3eb7ad081a374f09cdde554341424d"
  },
  "cases": [
    {
      "name": "anonymous-buffer-and-filter",
      "template": "before<%block filter=\"trim,h\">   ${title}   </%block>after",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "before&lt;b&gt;&amp; &#34;&#39;after"
    },
    {
      "name": "anonymous-unfiltered-scope",
      "template": "<% x = \"outer\" %><%block><% x = \"inner\" %>${x}</%block>|${x}",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "inner|outer"
    },
    {
      "name": "anonymous-nested-filters",
      "template": "<%block filter=\"h\">x\n<%block filter=\"trim\">  ${title}  </%block>y</%block>",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "x\n&lt;b&gt;&amp; &#34;&#39;y"
    },
    {
      "name": "anonymous-buffered-return-ignored",
      "template": "before<%block buffered=\"True\" filter=\"trim\"> ${title} </%block>after",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "beforeafter"
    },
    {
      "name": "anonymous-no-default-marker",
      "template": "<%block filter=\"n,trim\">  ${title}  </%block>",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "<b>& \"'"
    },
    {
      "name": "anonymous-same-line-conflict",
      "template": "<%block filter=\"h\">x<%block filter=\"trim\">y</%block></%block>",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "<%block filter=\"h\">x<%block filter=\"trim\">y</%block></%block>"
    },
    {
      "name": "page-global-filter-and-order",
      "template": "${title}::<%page expression_filter=\"trim\"/>[${title | h}]",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "<b>& \"'::[&lt;b&gt;&amp; &#34;&#39;]"
    },
    {
      "name": "page-and-expression-n-marker",
      "template": "<%page expression_filter=\"trim,h\"/>[${title | n}]|${title}",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "[ <b>& \"' ]|&lt;b&gt;&amp; &#34;&#39;"
    },
    {
      "name": "page-n-skips-str",
      "template": "<%page expression_filter=\"n,repr\"/>${count}|${title}",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "7|' <b>& \"\\' '"
    },
    {
      "name": "page-filters-in-def-and-block",
      "template": "<%page expression_filter=\"trim\"/><%def name=\"f()\">[${title}]</%def>${f()}|<%block>[ ${title} ]</%block>",
      "vars": {
        "title": " <b>& \"' ",
        "count": 7
      },
      "expected": "[<b>& \"']|[ <b>& \"' ]"
    }
  ]
}
