ea","props":{"model":"strm_path_mappings","label":"STRM路径映射","rows":4,"placeholder":"STRM目录:local:视频目录，每行一个映射关系\n例如：/ssd/strm:local:/media\n例如：/nas/strm:local:/media/tv"}}]}]},{"component":"VRow","content":[{"component":"VCol","props":{"cols":12},"content":[{"component":"VAlert","props":{"type":"info","variant":"tonal","text":"STRM文件监控：启用后会自动监控映射中的STRM目录，当STRM文件删除时会查找并删除本地存储上对应的视频文件。路径映射格式：STRM目录:local:视频目录，例如 /ssd/strm:local:/media 表示 /ssd/strm/test.strm 对应本地存储中以 /media/test 为前缀的视频文件。"}}]}]},{"component":"VRow","content":[{"component":"VCol","props":{"cols":12},"content":[{"component":"VAlert","props":{"type":"success","variant":"tonal","text":"支持的存储类型：local（本地存储）。"}}]}]},{"component":"VRow","content":[{"component":"VCol","props":{"cols":12},"content":[{"component":"VDivider","props":{"style":"margin: 20px 0;"}}]}]},{"component":"VRow","content":[{"component":"VCol","props":{"cols":12},"content":[{"component":"VAlert","props":{"type":"warning","variant":"tonal","text":"联动删除种子需安装插件[下载器助手]并打开监听源文件事件。清理刮削文件功能会删除相关的.nfo、.jpg等元数据文件，请谨慎开启。"}}]}]}]}],"model":{"custom_scrap_extensions":"","delay_seconds":30,"delayed_deletion":true,"delete_history":false,"delete_scrap_infos":false,"delete_torrents":false,"enabled":false,"exclude_dirs":"","exclude_keywords":"","monitor_dirs":"","monitor_strm_deletion":false,"notify":false,"strm_path_mappings":""},"render_mode":"vue"},"request_id":"req_U_GN4jeOspPy3fB3CADSzWQ5"},"status":200}}
