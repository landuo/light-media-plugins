  "library": [
    {
      "class_name": "BaseScheduler",
      "path": "/opt/venv/lib/python3.12/site-packages/apscheduler/schedulers/base.py",
      "sha256": "a27afd46e62c402a2b5bd7e4f0a017c08259dc680245a65dfa3f79c66ad52d2b",
      "methods": {
        "shutdown": {
          "signature": "(self, wait=True)",
          "source": "    @abstractmethod\n    def shutdown(self, wait=True):\n        \"\"\"\n        Shuts down the scheduler, along with its executors and job stores.\n\n        Does not interrupt any currently running jobs.\n\n        :param bool wait: ``True`` to wait until all currently executing jobs have finished\n        :raises SchedulerNotRunningError: if the scheduler has not been started yet\n\n        \"\"\"\n        if self.state == STATE_STOPPED:\n            raise SchedulerNotRunningError\n\n        self.state = STATE_STOPPED\n\n        # Shut down all executors\n        with self._executors_lock, self._jobstores_lock:\n            for executor in self._executors.values():\n                executor.shutdown(wait)\n\n            # Shut down all job stores\n            for jobstore in self._jobstores.values():\n                jobstore.shutdown()\n\n        self._logger.info(\"Scheduler has been shut down\")\n        self._dispatch_event(SchedulerEvent(EVENT_SCHEDULER_SHUTDOWN))\n"
        }
      }
    },
    {
      "class_name": "BackgroundScheduler",
      "path": "/opt/venv/lib/python3.12/site-packages/apscheduler/schedulers/background.py",
      "sha256": "b1136b8a4521a726e5bc0e510a9282e438ef7f7f9be8d1ef9d74db97196a21a3",
      "methods": {
        "shutdown": {
          "signature": "(self, *args, **kwargs)",
          "source": "    def shutdown(self, *args, **kwargs):\n        super().shutdown(*args, **kwargs)\n        self._thread.join()\n        del self._thread\n"
        }
      }
    },
    {
      "class_name": "BlockingScheduler",
      "path": "/opt/venv/lib/python3.12/site-packages/apscheduler/schedulers/blocking.py",
      "sha256": "d77f2b7fd5f50be6715954d500efe9c9f60c04a864a8edaa66a268c86227bf97",
      "methods": {
        "shutdown": {
          "signature": "(self, wait=True)",
          "source": "    def shutdown(self, wait=True):\n        super().shutdown(wait)\n        self._event.set()\n"
        }
      }
    },
    {
      "class_name": "BasePoolExecutor",
      "path": "/opt/venv/lib/python3.12/site-packages/apscheduler/executors/pool.py",
